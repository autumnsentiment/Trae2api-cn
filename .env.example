# Trae CN Relay 配置
# ----------------------------------------
# 认证来源，可选：
#   auto   - 自动从本地 Trae CN / SOLO CN 的 storage.json 解密；
#            失败时回退 .env token，最后尝试本地 Trae CLI
#   env    - 使用下面 TRAE_TOKEN / TRAE_REFRESH_TOKEN / TRAE_USER_ID
#   manual - 使用 TRAE_MANUAL_TOKEN（网页/App 抓包得到的 Cloud-IDE-JWT）
#   cli    - 使用本地 Trae CLI 子进程，不需要 JWT
#   web-login - 浏览器授权登录（启动时无需 token，登录后自动写入 .env）
TRAE_AUTH_SOURCE=auto
# 浏览器授权登录（TRAE_AUTH_SOURCE=web-login 时使用）
TRAE_AUTH_URL=https://www.trae.cn/authorization
WEB_LOGIN_LISTENER_PORT=8765

# Trae CLI 上游（TRAE_AUTH_SOURCE=cli 或 UPSTREAM_MODE=cli 时使用）
# 可写绝对路径、PATH 中的命令名，或多个候选用逗号分隔
# Trae CLI v2 的 llm 子命令可配置 TRAE_CLI_COMMAND=llm
TRAE_CLI_COMMAND=
TRAE_CLI_COMMANDS=
# json 自动解析结构化输出；不支持的 CLI 可改 text
TRAE_CLI_OUTPUT_MODE=json
# arg = prompt 作为最后一个参数；stdin = prompt 写入 stdin
TRAE_CLI_PROMPT_MODE=arg
# auto 时使用的默认模型；留空让 CLI 自己决定
TRAE_CLI_MODEL=
# default / config / flag / none
TRAE_CLI_MODEL_MODE=default
# 自定义模型参数名，例如 --model、--config、-c
TRAE_CLI_MODEL_ARG=
# 额外 CLI 参数，默认 -p
TRAE_CLI_ARGS=-p
# CLI 工作目录；留空使用 ~/.trae-cn-relay/work
TRAE_CLI_WORKDIR=
# 单次 CLI 查询超时（秒）
TRAE_CLI_QUERY_TIMEOUT=300
# API tool/result continuations reuse one terminal-protocol session for this
# idle period. A new request refreshes the lease; after it expires the relay
# drops the pinned credential and conversation mapping.
TRAE_SESSION_IDLE_TIMEOUT_SECONDS=60
TRAE_SESSION_REAP_INTERVAL_SECONDS=5
# 最大并发 CLI 子进程数
TRAE_CLI_MAX_CONCURRENCY=2
# 默认禁用 Read/Bash/Edit/Replace/Write/Glob/Grep/Task，避免反代变成本机执行入口
TRAE_CLI_DISABLE_TOOLS=true
# 出现工具字段或工具历史时会强制禁用默认项，并与这里的额外内置工具取并集
TRAE_CLI_DISALLOWED_TOOLS=Read,Bash,Edit,Replace,Write,Glob,Grep,Task
# 拼 prompt 时最多保留的消息数 / 最大字符数
TRAE_CLI_MAX_MESSAGES=60
TRAE_CLI_MAX_PROMPT_CHARS=20000

# Trae 原生 raw chat（推荐用于调用方终端工具桥接）
# 留空时依次使用 TRAE_API_HOST、认证记录中的 host、内置默认地址
TRAE_RAW_BASE_URL=
TRAE_RAW_APP_ID=6eefa01c-1036-4c7e-9ca5-d891f63bfcd8
TRAE_RAW_IDE_VERSION_CODE=20260401
# 调用端未逐请求传 client_context 时的全局后备；多客户端建议每次请求传真实值
TRAE_CLIENT_WORKSPACE_PATH=C:\workspace
TRAE_CLIENT_SYSTEM_TYPE=Windows

# 网页版反向代理模式（参考 OmniRoute 的 solo.trae.ai 方案）
# cn 版对应端点：https://core-normal.trae.cn/api/remote/v1
TRAE_WEB_BASE_URL=https://trae-api-cn.mchost.guru/api/remote/v1
TRAE_WEB_CLIENT_TYPE=web
TRAE_WEB_LANGUAGE=zh-CN
TRAE_WEB_REGION=cn
TRAE_WEB_APP_VERSION=1.0.0.1229
TRAE_WEB_APP_LANGUAGE=zh-CN
TRAE_WEB_USER_REGION=CN
TRAE_WEB_USER_IDENTITY=Free
TRAE_WEB_SCOPE=marscode-cn
TRAE_WEB_TENANT=marscode
TRAE_WEB_AI_REGION=cn
TRAE_WEB_PARALLEL_LIMIT=2
TRAE_WEB_IDLE_TIMEOUT=60

# Trae CN IDE 客户端版本标识（上游 /api/agent/v3/llm_utils_chat 等使用）
TRAE_IDE_VERSION=3.3.67
TRAE_IDE_VERSION_CODE=20260401
TRAE_IDE_VERSION_CODE_NUM=20260401
TRAE_APP_ID=6eefa01c-1036-4c7e-9ca5-d891f63bfcd8
# /v1/models 是否尝试从上游拉取真实模型列表；默认 false 使用内置模型表
TRAE_FETCH_MODEL_LIST=false

# 手动模式下的 JWT（仅 TRAE_AUTH_SOURCE=manual 时使用）
TRAE_MANUAL_TOKEN=

# 通过让 Trae CN 网页版登录后，从浏览器 DevTools 抓取的一组身份字段
# （可选，用于覆盖 common_params 中的身份信息）
TRAE_WEB_ID=
TRAE_BIZ_USER_ID=
TRAE_USER_UNIQUE_ID=

# IDE/raw 上游地址后备（仅 TRAE_AUTH_SOURCE=auto/env/manual/web-login 时使用）
# TRAE_API_HOST=https://trae-api-cn.mchost.guru
TRAE_API_HOST=

# 刷新令牌用的 ClientID（自动模式会从 storage.json 读取）
TRAE_CLIENT_ID=

# 认证快照（start.bat 会自动按需写入，通常无需手动填写）
TRAE_TOKEN=
TRAE_REFRESH_TOKEN=
TRAE_USER_ID=
TRAE_TOKEN_EXPIRES=
TRAE_REFRESH_EXPIRES=
TRAE_EDITION=cn

# 中转站监听配置
HOST=0.0.0.0
PORT=8000
RELAY_API_KEYS=your-master-key
# 多个 key 用逗号分隔：RELAY_API_KEYS=key1,key2

# 请求转发模式
# raw  - 只使用 Trae 终端协议直连，不回退到 remote/web/ide/CLI
# remote/9router - 使用 9router 风格 chat_sessions + events remote 转发
# auto - 与 raw 相同，所有模型请求直达 Trae 原生 llm_utils_chat
# raw  - 只用 Trae 原生 llm_utils_chat（direct 是同义值，需要 Cloud-IDE-JWT）
# cli  - 只用本地 Trae CLI 子进程
# web  - 只用旧版网页版 remote 会话；工具字段/历史请求会返回 400
# ide  - 只用 IDE chat 端点；工具字段/历史请求会返回 400
UPSTREAM_MODE=raw

# 多账号实际 claim 之间的间隔，以及上游 9074 后前端建议等待时间（秒）
TRAE_CHECKIN_INTERVAL_SECONDS=60
TRAE_CHECKIN_9074_RETRY_SECONDS=60

# 流式超时（秒）
STREAM_TIMEOUT=300

# SSE 空窗心跳间隔（秒）；0 表示关闭。注释帧不会进入模型正文。
SSE_HEARTBEAT_SECONDS=1

# 是否把 Trae 的 usage 透传给客户端
FORWARD_USAGE=true

# 消费记录独立文件（不要与 data/accounts.json 混用）；默认写入 data/usage_records.json
# TRAE_USAGE_RECORDS_PATH=/app/data/usage_records.json

# 请求完成后等待积分账单落库的秒数；后台快照差值计算，不阻塞模型首帧
TRAE_USAGE_CREDIT_SETTLE_SECONDS=1

# Responses previous_response_id 临时会话缓存（仅进程内，容器重启后失效）
RESPONSES_SESSION_TTL_SECONDS=3600
RESPONSES_SESSION_MAX_ENTRIES=1024
RESPONSES_SESSION_MAX_BYTES=2097152
RESPONSES_SESSION_MAX_MESSAGES=256

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
