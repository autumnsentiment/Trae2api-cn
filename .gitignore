# Runtime state and credentials
/.env
/.env.local
/data/
/logs/
/work/
/output/
/.native/

# Python and test caches
__pycache__/
*.py[cod]
/.pytest_cache/
/.venv/
/venv/

# Local diagnostics and one-off deployment helpers. These may contain account
# identifiers or host credentials and are deliberately kept outside releases.
/_*.py
/tmp*.py
/temp*.txt
/deploy*.py
/check_*.py
/verify*.py
/patch_*.py
/redeploy_*.py
/fix_perms.py
/switch_upstream.py
/start.bat
/traework_inspection.txt

# Generated artifacts and source snapshots
/backups/
/_baseline_src/
/*.bundle
/*.tgz
/*.tar.gz
/*.bin
*.bak
